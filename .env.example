# ============================================================
# ChurnIQ — root .env.example
# Copy to .env.docker and fill in real values before deploying.
# NEVER commit a file containing real secrets.
# ============================================================

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_DB=churniq
POSTGRES_USER=churniq
# Required — replace with a strong, unique password.
POSTGRES_PASSWORD=CHANGE_ME_strong_password

# ── Backend / FastAPI ────────────────────────────────────────
# Required in production — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME_long_random_secret

ENVIRONMENT=production

# Comma-separated list of origins the browser is allowed to call the API from.
CORS_ORIGINS=http://localhost:5173

# Comma-separated trusted hostnames for the TrustedHost middleware.
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Set to true when serving behind HTTPS (recommended in production).
HTTPS_ENFORCE=false

# ── Port bindings (host-side) ────────────────────────────────
API_PORT=8000
FRONTEND_PORT=5173

# ── Optional tuning ─────────────────────────────────────────
# Maximum CSV upload size in bytes (default 50 MB).
# MAX_UPLOAD_SIZE_BYTES=52428800

# Days before soft-deleted datasets become eligible for purge.
# DATASET_RETENTION_DAYS=30

